# ── Supabase (필수) ───────────────────────────────────────────
# 없으면 로그인·데이터 조회가 전부 실패한다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service-role — 봇 인입이 RLS 를 우회할 때만 쓴다. 절대 클라이언트 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인. 봇 연동 탭이 안내하는 엔드포인트 주소를 만드는 데 쓴다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 봇 연동 (필수) ────────────────────────────────────────────
# bot/speciai-bot.js 의 TOKEN 과 같은 값. 인입·규칙 라우트가 이 토큰으로 인증한다.
# 생성: openssl rand -hex 32
KAKAO_INGEST_TOKEN=
# 봇이 보낸 메시지를 쌓을 워크스페이스 UUID.
# 봇은 로그인 세션이 없어 스스로 워크스페이스를 모른다. 미설정이면 워크스페이스가
# 딱 하나일 때만 그것으로 폴백하고, 둘 이상이면 인입을 거부한다.
KAKAO_WORKSPACE_ID=

# ── 브랜딩 (선택) ─────────────────────────────────────────────
# 회사명. 화면 상단·문서 title 에 들어간다.
NEXT_PUBLIC_BRAND_NAME=카톡 통합함
# 상단 좌측 원형 마크 1글자.
NEXT_PUBLIC_BRAND_MARK=톡
# 대화창에서 우리측 발화에 붙는 칩 라벨.
NEXT_PUBLIC_STAFF_LABEL=우리
NEXT_PUBLIC_BRAND_TAGLINE=거래처 카톡 통합 콘솔

# ── 멤버 초대 메일 (선택) ─────────────────────────────────────
# 없으면 초대 링크를 수동 전달한다.
RESEND_API_KEY=
RESEND_FROM=
